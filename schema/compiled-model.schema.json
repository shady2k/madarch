{
  "type": "object",
  "required": [
    "schemaVersion",
    "elements",
    "interfaces",
    "relations",
    "categories",
    "zones",
    "environments",
    "states"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "ancestors",
          "zones",
          "zonesByEnvironment",
          "environments",
          "states"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "person"
              },
              {
                "type": "string",
                "const": "external"
              },
              {
                "type": "string",
                "const": "domain"
              },
              {
                "type": "string",
                "const": "system"
              },
              {
                "type": "string",
                "const": "service"
              },
              {
                "type": "string",
                "const": "module"
              },
              {
                "type": "string",
                "const": "store"
              },
              {
                "type": "string",
                "const": "broker"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "ancestors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ancestor ids, ordered from the root down to the immediate parent."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The element's zones, worked out after inheritance, add, exclude and replace."
          },
          "zonesByEnvironment": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "description": "The element's zones in each environment it exists in, listing only the environments it exists in, after that environment's own changes."
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The environments it exists in, after inheriting and narrowing presence: the sorted ids of the environments it is in, or the single sentinel id \"*\" when the model declares no environments at all (in which case everything is trivially unrestricted). Never empty otherwise: a thing that exists in no environment is refused before compilation."
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The states it exists in, first to last in the chain; every state when unrestricted."
          }
        },
        "additionalProperties": false
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "interaction",
          "environments",
          "states"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "refines": {
            "type": "string"
          },
          "interface": {
            "type": "string"
          },
          "interaction": {
            "type": "boolean",
            "description": "True when the relation carries an interface or transfers: it is an interaction."
          },
          "binding": {
            "type": "object",
            "required": [
              "env"
            ],
            "properties": {
              "env": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "bindingByEnvironment": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            },
            "description": "The binding variable's value in each environment the relation exists in. An environment that does not define the variable has no key here: a binding variable an environment leaves unset is recorded as absent, never as an error."
          },
          "transfers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "direction",
                "confidentiality",
                "categories"
              ],
              "properties": {
                "direction": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "forward"
                    },
                    {
                      "type": "string",
                      "const": "reverse"
                    }
                  ]
                },
                "confidentiality": {
                  "type": "string",
                  "minLength": 1
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The environments it exists in, after inheriting and narrowing presence: the sorted ids of the environments it is in, or the single sentinel id \"*\" when the model declares no environments at all (in which case everything is trivially unrestricted). Never empty otherwise: a thing that exists in no environment is refused before compilation. A relation exists where both its ends do."
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The states the relation exists in: its own since/until, intersected with both its ends."
          }
        },
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string"
          },
          "bindings": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shady2k/madarch/schema/compiled-model.schema.json",
  "title": "Madarch compiled model",
  "description": "model.json: a loaded intended model with its references resolved, its zones and presence worked out per environment and state, and its contract ids normalized — the one shape every frontend and agent reads.",
  "additionalProperties": false
}
