{
  "type": "object",
  "required": [
    "contract",
    "author",
    "time",
    "thread",
    "anchor",
    "document",
    "sourceCommit",
    "status"
  ],
  "properties": {
    "contract": {
      "type": "number",
      "const": 1,
      "description": "The discussion-message contract version; this schema publishes version 1."
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
      "format": "date-time",
      "description": "The message creation time in ISO 8601 date-time form with an explicit UTC offset."
    },
    "thread": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "minLength": 26,
      "maxLength": 26
    },
    "anchor": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "page"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "quote",
            "before",
            "after"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "selection"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "before": {
              "type": "string",
              "maxLength": 32,
              "description": "Up to 32 Unicode code points immediately before the selected quote."
            },
            "after": {
              "type": "string",
              "maxLength": 32,
              "description": "Up to 32 Unicode code points immediately after the selected quote."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "document": {
      "type": "string",
      "pattern": "^docs/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?:[^/]+/)*[^/]+\\.md$",
      "description": "A product-relative Markdown document path under docs/, without dot-segment traversal."
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The 40-character source commit hash."
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "open"
        },
        {
          "type": "string",
          "const": "resolved"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shady2k/madarch/schema/v1/product-discussion-message.schema.json",
  "title": "Madarch product discussion message",
  "description": "One Markdown message under comments/<thread ULID>/<message ULID>.md. Its front matter is versioned independently of generic product document fields.",
  "additionalProperties": false
}
