{
  "type": "object",
  "required": [
    "contract",
    "stages",
    "kinds"
  ],
  "properties": {
    "contract": {
      "type": "number",
      "const": 1,
      "description": "The contract version the registry is written against; this schema publishes version 1."
    },
    "overview": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "object",
          "required": [
            "document",
            "section"
          ],
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "rules"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
            "minLength": 1
          },
          "perspective": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "The rules the level holds; a rule names a count, a coverage, a provenance agreement or an approval by role."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "The reserved goals section: maturity levels over the graph, per perspective (the 0021 amendment). This engine version keeps the section and names it as reserved-but-unimplemented when it renders; never a silent unknown section."
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
            "minLength": 1
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sections": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "architecture"
                },
                {
                  "type": "string",
                  "const": "repositories"
                }
              ]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "The life cycle in the order the reader walks it; every kind names one of these."
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "prefix",
          "folder",
          "stage",
          "hint"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "description": "Two to four capitals (A-Z), checked when the registry is read."
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "description": "A place under docs/, like docs/requirements; checked when the registry is read."
          },
          "stage": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
              "minLength": 1
            },
            "description": "The allowed statuses of the kind, as the documents write them."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "targets"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The field name as the document's form writes it, like Grew from, Serves."
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "description": "The kinds this link may go to, each a kind of the registry."
                },
                "backlink": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                  "minLength": 1
                },
                "cardinality": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "one"
                    },
                    {
                      "type": "string",
                      "const": "many"
                    }
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "description": "The links the kind declares: field name, allowed target kinds, the backlink's label, the cardinality and whether the link is required."
          },
          "questions": {
            "type": "object",
            "required": [
              "identityPrefix",
              "titleSeparator",
              "promptSection",
              "answerSection"
            ],
            "properties": {
              "identityPrefix": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "titleSeparator": {
                "type": "string",
                "minLength": 1
              },
              "promptSection": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                "minLength": 1
              },
              "answerSection": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                "minLength": 1
              },
              "answererField": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                "minLength": 1
              },
              "concernsField": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                "minLength": 1
              },
              "notApplicablePrefix": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "storage": {
            "anyOf": [
              {
                "type": "string",
                "const": "document"
              },
              {
                "type": "string",
                "const": "task"
              },
              {
                "type": "string",
                "const": "model-element"
              },
              {
                "type": "string",
                "const": "component"
              },
              {
                "type": "string",
                "const": "fact"
              }
            ],
            "description": "How the kind is stored inside the product. document is what this engine version implements; the other forms are reserved and kept as data, named by an honest finding, never dropped."
          },
          "evidence": {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                "minLength": 1
              },
              "record": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "description": "The kinds the product holds, each naming its stage of the list."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shady2k/madarch/schema/v1/product-registry.schema.json",
  "title": "Madarch product kinds registry",
  "description": "The shape of one product repository kinds registry file, at contract version 1: the stages as an ordered list with no fixed kinds, and the kinds the product holds, each with its name, id prefix, folder, stage, next-step hint, allowed statuses and declared link types. The mechanism is madarch's; the kinds (usually written at setup by the skill set) are the product's data.",
  "additionalProperties": false
}
