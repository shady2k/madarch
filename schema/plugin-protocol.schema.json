              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "object",
              "properties": {
                "cause": {
                  "type": "string",
                  "minLength": 1
                },
                "unitId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "A request's answer, failed, with the cause in the error's data."
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shady2k/madarch/schema/v2/plugin-protocol.schema.json",
  "title": "Madarch extraction plugin protocol",
  "description": "One message of the host/plugin protocol, contract version 1: JSON-RPC 2.0 over newline delimited JSON on the plugin's standard input and output. The plugin introduces itself (introduce), the host hands it units (unit), and the plugin answers with a PluginUnitResult, progress, heartbeats and errors. Every kind and field a message names is declared in the introduction's outputs. The host asks pause, resume and stop, and sends cancel; a pause suspends the heartbeat deadline, a stop asks for the unit to finish and the plugin to exit, and a cancel kills the whole tree."
}
