{
  "name": "db-schema",
  "version": "1.0.0",
  "tier": "ordinary",
  "capabilities": [
    "git"
  ],
  "entry": "main.ts",
  "runtime": {
    "name": "bun",
    "version": "1.4.2"
  },
  "description": "The db-schema plugin: reads the SQL of TypeScript sources and answers the database's tables, columns, indexes and the links between them (decision 0035; task madarch-47vw.3).",
  "produces": [
    {
      "kind": "code.database",
      "fields": "*",
      "reads": [
        "code.file"
      ]
    },
    {
      "kind": "code.table",
      "fields": "*",
      "reads": [
        "code.file"
      ]
    },
    {
      "kind": "code.column",
      "fields": "*",
      "reads": [
        "code.file"
      ]
    },
    {
      "kind": "code.index",
      "fields": "*",
      "reads": [
        "code.file"
      ]
    }
  ],
  "concurrency": 1,
  "labels": {
    "en": "Database schema",
    "ru": "\u0421\u0445\u0435\u043c\u0430 \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445"
  }
}
