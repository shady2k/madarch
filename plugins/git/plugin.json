{
  "name": "git",
  "version": "1.0.0",
  "tier": "core",
  "capabilities": [
    "git"
  ],
  "entry": "entry.ts",
  "runtime": {
    "name": "bun",
    "version": "1.4.2"
  },
  "tools": [
    {
      "name": "git",
      "source": "system",
      "minimumVersion": "2.31"
    }
  ],
  "produces": [
    {
      "kind": "code.repository",
      "fields": [
        "history_shallow"
      ],
      "reads": [
        {
          "kind": "code.repository",
          "version": "earlier",
          "producer": "disk"
        }
      ],
      "refines": [
        "disk"
      ],
      "support": {
        "vertices": [
          "code.commit"
        ],
        "edges": []
      }
    },
    {
      "kind": "code.file",
      "fields": [
        "path",
        "last_change",
        "commit_count",
        "added_at",
        "removed_at"
      ],
      "refines": [
        "disk"
      ],
      "reads": [
        {
          "kind": "code.file",
          "version": "earlier",
          "producer": "disk"
        },
        {
          "kind": "code.repository",
          "version": "earlier",
          "producer": "disk"
        }
      ],
      "support": {
        "vertices": [
          "code.commit"
        ],
        "edges": []
      }
    },
    {
      "kind": "code.commit",
      "fields": "*",
      "reads": [
        "code.file",
        {
          "kind": "code.repository",
          "version": "earlier",
          "producer": "disk"
        }
      ],
      "partition": "key",
      "support": {
        "vertices": [
          "code.commit"
        ],
        "edges": []
      }
    },
    {
      "kind": "code.author",
      "fields": "*",
      "reads": [
        "code.file",
        {
          "kind": "code.repository",
          "version": "earlier",
          "producer": "disk"
        }
      ],
      "support": {
        "vertices": [
          "code.commit"
        ],
        "edges": []
      }
    }
  ],
  "concurrency": 1,
  "labels": {
    "en": "Git history",
    "ru": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f git"
  }
}
