{
  "name": "disk",
  "version": "1.0.0",
  "tier": "core",
  "capabilities": [
    "filesystem"
  ],
  "entry": "entry.ts",
  "runtime": {
    "name": "bun",
    "version": "1.4.2"
  },
  "tools": [
    {
      "name": "git",
      "source": "system",
      "minimumVersion": "2.40"
    }
  ],
  "produces": [
    {
      "kind": "code.repository",
      "fields": [
        "url",
        "default_branch",
        "tree_snapshot"
      ],
      "reads": [],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    },
    {
      "kind": "code.directory",
      "fields": "*",
      "reads": [],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    },
    {
      "kind": "code.file",
      "fields": "*",
      "reads": [],
      "partition": "key",
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    },
    {
      "kind": "code.gitlink",
      "fields": "*",
      "reads": [],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    }
  ],
  "concurrency": 1,
  "labels": {
    "en": "File system",
    "ru": "\u0424\u0430\u0439\u043b\u043e\u0432\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430"
  }
}
