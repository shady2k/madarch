{
  "name": "disk",
  "version": "1.0.0",
  "entry": "entry.ts",
  "runtime": {
    "name": "bun",
    "version": "1.4.2"
  },
  "tools": [
    {
      "name": "git",
      "source": "system",
      "minimumVersion": "2.40"
    }
  ],
  "produces": [
    {
      "kind": "code.repository",
      "fields": [
        "url",
        "default_branch",
        "tree_snapshot"
      ],
      "reads": [],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    },
    {
      "kind": "code.directory",
      "fields": "*",
      "reads": [],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    },
    {
      "kind": "code.file",
      "fields": "*",
      "reads": [],
      "partition": "key",
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    },
    {
      "kind": "code.gitlink",
      "fields": "*",
      "reads": [],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    }
  ],
  "concurrency": 1,
  "labels": {
    "en": "File system",
    "ru": "Файловая система"
  }
}
