{
  "name": "glossary",
  "version": "1.0.0",
  "entry": "main.ts",
  "runtime": {
    "name": "bun",
    "version": "1.4.2"
  },
  "description": "The glossary plugin: reads a glossary document and answers its terms (decision 0035).",
  "produces": [
    {
      "kind": "doc.term",
      "fields": "*",
      "reads": [
        "code.file"
      ],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    }
  ],
  "concurrency": 1,
  "labels": {
    "en": "Glossary",
    "ru": "Глоссарий"
  }
}
