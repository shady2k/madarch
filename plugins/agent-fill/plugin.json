{
  "name": "agent-fill",
  "version": "1.0.0",
  "tier": "ordinary",
  "capabilities": [
    "agents"
  ],
  "entry": "main.ts",
  "runtime": {
    "name": "bun",
    "version": "1.4.2"
  },
  "description": "Fills kinds from their manifest definitions and graph evidence through a host-supervised agent.",
  "produces": [
    {
      "kind": "*",
      "fields": "*",
      "reads": [
        "code.file",
        "code.blob"
      ],
      "coverage": "gaps"
    }
  ],
  "concurrency": 1,
  "agent": {
    "prompt": "prompt.md",
    "roots": [
      "."
    ],
    "catalogue": true
  },
  "labels": {
    "en": "Agent",
    "ru": "\u0410\u0433\u0435\u043d\u0442"
  }
}
