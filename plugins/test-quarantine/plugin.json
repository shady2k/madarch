{
  "name": "test-quarantine",
  "version": "1.0.0",
  "entry": "entry.ts",
  "runtime": {
    "name": "bun",
    "version": "1.4.2"
  },
  "description": "Reads explicit quarantined test markers from graph file content.",
  "produces": [
    {
      "kind": "code.test-quarantine",
      "fields": "*",
      "reads": [
        "code.file"
      ],
      "support": {
        "vertices": [
          "code.blob"
        ],
        "edges": [
          "code.blob-about"
        ]
      }
    }
  ],
  "concurrency": 1,
  "labels": {
    "en": "Test quarantine",
    "ru": "Карантин тестов"
  }
}
