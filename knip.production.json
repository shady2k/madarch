{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "bun": false,
  "entry": [
    "scripts/madarch.ts!",
    "wiki/app/index.html!",
    "wiki/app/src/main.tsx!",
    "wiki/app/vite.config.ts!"
  ],
  "project": [
    "scripts/**/*.ts!",
    "src/**/*.ts!",
    "test/**/*.ts!",
    "wiki/app/src/**/*.ts!",
    "wiki/app/src/**/*.tsx!",
    "wiki/app/test/**/*.ts!",
    "wiki/app/vite.config.ts!"
  ],
  "ignore": [
    "test/fixtures/**",
    "wiki/app/dist/**",
    "wiki/app/test/fixtures/**",
    "wiki/starlight/**"
  ],
  "include": [
    "files",
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "enumMembers"
  ]
}
