#!/bin/sh
# Points a new checkout at the machine's tracker store (see
# .shady2k/integration.md, "Tracker layout"). git runs this after
# `git worktree add` (and every checkout): a new worktree has no .beads link
# yet, and br there would find no tracker. Anything else passes silently.
cd "$(git rev-parse --show-toplevel)" || exit 0
[ -f .githooks/tracker-home.sh ] && [ -f .shady2k/tracker.mjs ] || exit 0
.githooks/tracker-home.sh >/dev/null 2>&1 && exit 0
# A branch from before the store moved leaves a .beads folder of its own; the
# mechanism moves one that holds only locks aside and links the store back, and
# refuses and names one that holds a tracker. tracker.mjs names this machine's
# store, so the line carries no machine's paths (setup 0.51.0).
# shady2k tracker-sync relink: this line puts a checkout back on the store when a branch left a folder there
node .shady2k/tracker.mjs relink --checkout "$(git rev-parse --show-toplevel)" || true
.githooks/tracker-home.sh >/dev/null 2>&1 && exit 0
[ -e .beads ] && ! [ -L .beads ] && { echo "post-checkout: a real .beads stands in $(pwd); it is left alone. Move it away, then run sh .shady2k/connect.sh here."; exit 0; }
store="$(node .shady2k/tracker.mjs store 2>/dev/null)" || { echo "post-checkout: the tracker store's entry point does not run here, so this checkout is not linked; run sh .shady2k/connect.sh here before using br."; exit 0; }
[ -d "$store/.beads" ] || { echo "post-checkout: this machine has no tracker store yet; run sh .shady2k/connect.sh in the main checkout."; exit 0; }
echo "post-checkout: linking this checkout's .beads to the machine's tracker store"
(cd "$store" && node "$OLDPWD/.shady2k/trackers/br.mjs" pointer-install --checkout "$OLDPWD") >/dev/null 2>&1 || \
  echo "post-checkout: this checkout is not linked; run sh .shady2k/connect.sh here before using br."
exit 0
