{
  "name": "madarch",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test/",
    "schemas": "bun scripts/generate-schemas.ts",
    "views": "bun scripts/render-views.ts",
    "views:check": "bun scripts/check-views.ts",
    "contract:check": "bun scripts/check-contract.ts",
    "wiki:demo": "cd wiki/app && bun install --frozen-lockfile && bun run build && cd ../.. && bun scripts/madarch.ts serve --product wiki/demo",
    "wiki:shots": "bun scripts/wiki-shots.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "decode-named-character-reference": "1.2.0",
    "pg": "^8.23.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "typebox": "1.3.34",
    "unified": "11.0.5",
    "web-tree-sitter": "0.25.10",
    "xstate": "5.33.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.4.2",
    "@types/pg": "^8.23.1",
    "debug": "^4.4.3",
    "likec4": "1.59.4",
    "mermaid": "12.0.0",
    "puppeteer": "24.43.1",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "puppeteer"
  ],
  "bin": {
    "madarch": "./scripts/madarch.ts"
  }
}
