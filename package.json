{
  "name": "madarch",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "tsc --noEmit && bun run check:architecture && bun run check:ui && bun run check:catalog && bun run check:workflows && bun run check:quarantine",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:ui": "bun scripts/check-ui-architecture.ts",
    "check:catalog": "bun scripts/check-catalog.ts",
    "check:quarantine": "bun scripts/check-quarantine.ts",
    "test:quarantine": "bun scripts/run-quarantine.ts",
    "check:workflows": "bun scripts/check-workflows.ts",
    "check:architecture-base": "bun scripts/check-architecture.ts --base-guard && bun scripts/check-ui-architecture.ts --base-guard",
    "test": "bun test test/",
    "wiki:demo": "cd wiki/app && bun install --frozen-lockfile && bun run build && cd ../.. && bun scripts/madarch.ts serve --product wiki/demo",
    "wiki:shots": "bun scripts/walk-shots.ts",
    "install:plugins": "bun scripts/plugin-deps.ts",
    "postinstall": "bun run install:plugins"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@colbymchenry/codegraph": "1.6.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "decode-named-character-reference": "1.2.0",
    "libpg-query": "18.2.1",
    "linguist-languages": "9.5.0",
    "liquidjs": "10.30.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "protobufjs": "7.5.4",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tinyld": "1.3.4",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-wasms": "^0.1.13",
    "typebox": "1.3.34",
    "unified": "11.0.5",
    "vscode-oniguruma": "1.7.0",
    "web-tree-sitter": "0.25.10",
    "xstate": "5.33.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@swc/core": "1.16.21",
    "@types/bun": "1.4.2",
    "@types/pg": "^8.23.1",
    "debug": "^4.4.3",
    "dependency-cruiser": "18.7.1",
    "graphql": "17.1.0",
    "knip": "6.44.1",
    "likec4": "1.59.4",
    "mermaid": "12.0.0",
    "puppeteer": "24.43.1",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "trustedDependencies": [
    "puppeteer"
  ],
  "bin": {
    "madarch": "./scripts/madarch.ts"
  }
}
