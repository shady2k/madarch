{
  "name": "madarch",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test/",
    "schemas": "bun scripts/generate-schemas.ts",
    "views": "bun scripts/render-views.ts",
    "views:check": "bun scripts/check-views.ts",
    "contract:check": "bun scripts/check-contract.ts",
    "wiki:demo": "cd wiki/app && bun install --frozen-lockfile && bun run build && cd ../.. && bun scripts/madarch.ts serve --product wiki/demo",
    "wiki:shots": "bun scripts/wiki-shots.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@ladybugdb/core": "0.20.4",
    "pg": "^8.23.1",
    "typebox": "1.3.34",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.4.2",
    "@types/pg": "^8.23.1",
    "debug": "^4.4.3",
    "likec4": "1.59.4",
    "mermaid": "12.0.0",
    "puppeteer-core": "24.43.1",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@ladybugdb/core"
  ],
  "bin": {
    "madarch": "./scripts/madarch.ts"
  }
}
